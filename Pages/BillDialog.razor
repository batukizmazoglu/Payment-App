<MudDialog>
    <DialogContent>
        <MudSelect T="string" Label="Company Name" Clearable="true" Required="true" @bind-Value="Model.CompanyName">
            @foreach (string CompanyName in Companies)
            {
                <MudSelectItem Value="@CompanyName">@CompanyName</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string" Label="Customer Name" Clearable="true" Required="true" @bind-Value="Model.CustomerName">
            @foreach (string CustomerName in Customers)
            {
                <MudSelectItem Value="@CustomerName">@CustomerName</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string" Label="Type" @bind-Value="Model.Type"></MudTextField>
        <MudTextField T="int" Label="Amount" @bind-Value="Model.Amount"></MudTextField>
        <MudTextField T="bool" Label="Paid" @bind-Value="Model.Paid"></MudTextField>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Add</MudButton>
    </DialogActions>
</MudDialog>